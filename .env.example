# Credenciales del panel admin (ver src/app/api/auth/admin/route.ts)
ADMIN_USER="admin@colegio.edu.co"
ADMIN_PASS="cambia-esto-en-produccion"

# La base de datos es Cloudflare D1 (SQLite, binding `DB` en wrangler.jsonc).
# No requiere DATABASE_URL. Para producción crea la DB con:
#   npx wrangler d1 create voting-db
# y pega el database_id en wrangler.jsonc.
