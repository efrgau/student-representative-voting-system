{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "student-voting-system",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "voting-db",
      // REEMPLAZAR: crea la DB real con `npx wrangler d1 create voting-db`
      // y pega aquí el database_id que devuelva.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle"
    }
  ]
  // Los secretos (ADMIN_USER, ADMIN_PASS) se configuran con:
  //   npx wrangler secret put ADMIN_USER
  //   npx wrangler secret put ADMIN_PASS
}
